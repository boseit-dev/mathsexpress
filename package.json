{
  "name": "mathsexpress",
  "version": "2.0.0-alpha.2",
  "private": true,
  "description": "MathsExpress 2.0: maths learning platform for NSW students and teachers.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "preview:worker": "npm run build && wrangler dev",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "node scripts/test-db.ts",
    "db:types": "supabase gen types typescript --local > src/data/supabase/database.types.ts && prettier --write src/data/supabase/database.types.ts",
    "check:quick": "npm run format:check && npm run lint && npm run typecheck",
    "check": "npm run check:quick && npm run test && npm run build",
    "prepare": "node scripts/setup-git-hooks.ts"
  },
  "dependencies": {
    "@fontsource-variable/lexend": "5.3.0",
    "@supabase/supabase-js": "2.118.0",
    "lucide-react": "1.62.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.14.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.154.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true,
    "fsevents": false
  }
}
