/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=(), display-capture=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  X-Permitted-Cross-Domain-Policies: none
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'self'; frame-ancestors 'none'; form-action 'self'; script-src 'self' https://cdn.jsdelivr.net https://unpkg.com https://receptra-staging.aarush-sharma6.workers.dev; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://receptra-staging.aarush-sharma6.workers.dev; font-src 'self' data:; frame-src 'self' blob: https://receptra-staging.aarush-sharma6.workers.dev; worker-src 'self' blob:; upgrade-insecure-requests

/api/*
  Cache-Control: no-store

# Every file below is requested with a ?v=<version> string that changes on each
# release, so a stale copy is never served after a deploy: the new version is a
# different URL. The day-long window plus background revalidation is for the
# service worker, which pre-fetches these same files without the query string.
# Listed one by one on purpose: a /*.js rule would also match service-worker.js,
# and that file must never be cached (see below).
/deploy-app.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/deploy-core-1.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/deploy-core-2.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/mathsexpress-config.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/mathsexpress-safe-math.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/quick-assign-due.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/receptra-widget.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/site-motion.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/startup-failsafe.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/supabase-loader.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/v7-features.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/site.css
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/styles.css
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/assets/*
  Cache-Control: public, max-age=2592000

# The service worker ships every other update, so it has to be revalidated on
# each load or a bad release can never be replaced.
/service-worker.js
  Cache-Control: no-cache

# Entry points carry the ?v= strings, so they must always be revalidated.
/index.html
  Cache-Control: no-cache

/app.html
  Cache-Control: no-cache
  X-Robots-Tag: noindex, nofollow

/robots.txt
  Cache-Control: public, max-age=3600

/sitemap.xml
  Cache-Control: public, max-age=3600
